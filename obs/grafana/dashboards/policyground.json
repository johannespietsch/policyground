{
  "uid": "policyground",
  "title": "PolicyGround",
  "tags": [
    "policyground"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Request path",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Questions per minute, by outcome",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (outcome) (rate(policyground_requests_total[5m])) * 60",
          "legendFormat": "{{outcome}}",
          "refId": "{"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(policyground_request_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "P"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(policyground_request_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "P"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Cost and LLM calls per question",
      "description": "LLM calls / question above 1 means regenerates (validator rejections). Capped at 2 (D27).",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum(rate(policyground_llm_cost_usd_total[15m])) / sum(rate(policyground_requests_total[15m]))",
          "legendFormat": "USD / question",
          "refId": "U"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum(rate(policyground_llm_calls_total[15m])) / sum(rate(policyground_requests_total[15m]))",
          "legendFormat": "LLM calls / question",
          "refId": "L"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Abstain rate (alert: > 2x baseline 14%)",
      "description": "Recording rule over 15m. AbstainRateHigh fires above 0.28 with >= 10 questions.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "policyground:abstain_rate:15m",
          "legendFormat": "abstain rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Abstentions by reason",
      "description": "validator = forced abstain after rejected regenerate (INCIDENTS #10); unresolved_property = name match failed (D22).",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (reason) (increase(policyground_abstentions_total[15m]))",
          "legendFormat": "{{reason}}",
          "refId": "{"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Tokens per question / validator rejections per question",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (direction) (rate(policyground_llm_tokens_total[15m])) / scalar(sum(rate(policyground_requests_total[15m])))",
          "legendFormat": "tokens {{direction}}",
          "refId": "T"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum(rate(policyground_validator_rejections_total[15m])) / sum(rate(policyground_requests_total[15m]))",
          "legendFormat": "rejections",
          "refId": "R"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "title": "Pipeline health (M3/M4)",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "KG / vector disagreement",
      "description": "Share of properties whose KG value differs from the newest production chunks: the staleness window (M4).",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "policyground_kg_vector_disagreement",
          "legendFormat": "{{tenant}}",
          "refId": "{"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "title": "Newest snapshot age",
      "description": "Since the newest production slice was ingested. A skipped nightly DAG run shows up here (INCIDENTS #8). SnapshotStale > 26h.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 4,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "policyground_newest_snapshot_age_seconds",
          "legendFormat": "{{tenant}}",
          "refId": "{"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Stream: events applied / ignored per minute",
      "description": "ignored = version guard rejected a duplicate or out-of-order event (D34, INCIDENTS #9).",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (outcome) (rate(policyground_stream_events_total[5m])) * 60",
          "legendFormat": "{{outcome}}",
          "refId": "{"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Stream: consumer lag by partition",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "policyground_stream_lag",
          "legendFormat": "partition {{partition}}",
          "refId": "P"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "table",
      "title": "Ingested slices (rows / duplicates per snapshot)",
      "description": "duplicates > 0 = the INCIDENTS #7 failure mode (non-idempotent re-run).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg"
          },
          "rawSql": "SELECT snapshot_date, chunker, embedder, rows, duplicates, ingested_at FROM chunk_slices WHERE tenant='hotels' ORDER BY snapshot_date DESC, chunker LIMIT 12",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "table",
      "title": "DAG eval task (eval_runs, retrieval only)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg"
          },
          "rawSql": "SELECT snapshot_date, chunker, chunk_rows, round((metrics->>'doc@5')::numeric,2) AS \"doc@5\", round((metrics->>'fact@5_filtered')::numeric,2) AS \"fact@5 filt.\", left(source, 40) AS source, created_at FROM eval_runs ORDER BY id DESC LIMIT 12",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "title": "Eval and drift (M4)",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "type": "table",
      "title": "Drift runs: score vs noise band",
      "description": "Probe set about exactly the mutated properties (D35). Band = mean +- 2 sigma, floored at sampling error (D37).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg"
          },
          "rawSql": "SELECT created_at, mutation, phase, graph, round(mean::numeric,2) AS mean, round(band_lo::numeric,2) AS band_lo, round(band_hi::numeric,2) AS band_hi, verdict FROM drift_runs ORDER BY created_at DESC LIMIT 12",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "title": "Logs (Loki) - filter by request_id, then search the same id in Phoenix (session)",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "type": "logs",
      "title": "API: questions (one line per /ask)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=\"api\"} |= \"\\\"msg\\\": \\\"ask\\\"\" | json",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "type": "logs",
      "title": "Consumer, exporter and errors",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=~\".+\"} | json | service=~\"consumer|exporter\" or level=\"error\"",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}